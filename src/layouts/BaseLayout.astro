---
import '../styles/global.css';
import Header from '../components/islands/Header';
import Footer from '../components/ui/Footer.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import SpineProgress from '../components/islands/SpineProgress';
import { site } from '../data/site';
import { img } from '../data/images';

interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; noindex?: boolean; published?: string; home?: boolean; }
const { title = `${site.name} | Chiropractic Care`, description = site.description, image = img.heroPoster, type = 'website', noindex = false, published, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const origin = (Astro.site ?? new URL('https://advancedback.com')).origin;
const absolute = (u: string) => (u.startsWith('http') ? u : origin + (u.startsWith('/') ? u : '/' + u));
const ogImage = absolute(image);

// "10:00 am – 12:00 pm, 3:00 pm – 6:00 pm" -> 24h pairs
const to24 = (t: string) => { const m = t.trim().match(/(\d+):(\d+)\s*(am|pm)/i)!; let h = +m[1] % 12; if (m[3].toLowerCase() === 'pm') h += 12; return `${String(h).padStart(2, '0')}:${m[2]}`; };
const openingHours = site.hours.flatMap((h) => {
  const ranges = [...h.time.matchAll(/(\d+:\d+\s*[ap]m)\s*[–-]\s*(\d+:\d+\s*[ap]m)/gi)];
  return ranges.map((r) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.day, opens: to24(r[1]), closes: to24(r[2]) }));
});
const org = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Chiropractor', 'LocalBusiness'],
      '@id': `${origin}/#practice`,
      name: site.name,
      url: `${origin}/`,
      image: ogImage,
      logo: absolute(img.logo),
      description: site.description,
      telephone: '+1-302-368-1300',
      faxNumber: '+1-302-368-1695',
      priceRange: '$$',
      address: { '@type': 'PostalAddress', streetAddress: '54 Omega Drive, Suite F', addressLocality: 'Newark', addressRegion: 'DE', postalCode: '19713', addressCountry: 'US' },
      hasMap: site.mapHref,
      areaServed: ['Newark, DE', 'Wilmington, DE', 'Pike Creek, DE', 'Elkton, MD'],
      openingHoursSpecification: openingHours,
      foundingDate: '1986',
    },
    { '@type': 'WebSite', '@id': `${origin}/#website`, url: `${origin}/`, name: site.name, publisher: { '@id': `${origin}/#practice` }, inLanguage: 'en-US' },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <meta name="theme-color" content="#0b1f2a" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {type === 'article' && published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {home && <script type="application/ld+json" set:html={JSON.stringify(org)} />}
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@300..800&family=Cormorant:ital,wght@0,400..700;1,400..700&family=Fraunces:ital,wght@1,600&family=Pinyon+Script&family=Playfair+Display:ital,wght@1,500&family=Roboto+Slab:wght@400..600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2">Skip to content</a>
    <Header client:load />
    <SpineProgress client:idle />
    <main id="main"><slot /></main>
    <Footer />

    <CookieBanner />

    <!-- scroll reveal -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.reveal, .reveal-l');
        if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        els.forEach(function (e) { io.observe(e); });
        // touch devices: tap a flip card to flip it
        document.querySelectorAll('.flip').forEach(function (f) {
          f.addEventListener('click', function (ev) {
            if (window.matchMedia('(hover: none)').matches && !ev.target.closest('a')) {
              f.dataset.flipped = f.dataset.flipped === 'true' ? 'false' : 'true';
            }
          });
        });
      })();
    </script>
  </body>
</html>
