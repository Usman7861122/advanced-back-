---
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
interface Props { title: string; eyebrow?: string; lede?: string; description?: string; image: string; imageAlt?: string; position?: string; crumbs?: { label: string; href?: string }[]; heading?: string; }
const { title, heading, description, ...hero } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <PageHero title={heading ?? title.split('|')[0].trim()} {...hero}><slot name="actions" /></PageHero>
  <slot />
</BaseLayout>
