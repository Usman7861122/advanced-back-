---
import { localFor } from '../../data/local';
interface Props { topic: string; }
const l = localFor(Astro.props.topic);
---
<section class="relative overflow-hidden bg-mist py-24 sm:py-28">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[1.1fr_1fr] lg:items-center">
    <div>
      <p class="eyebrow reveal">{l.eyebrow}</p>
      <h2 class="h-display reveal mt-4" style="--d:80ms">{l.sectionTitle}</h2>
      {l.text.map((t, i) => <p class="lead reveal mt-5 max-w-xl" style={`--d:${160 + i * 80}ms`}>{t}</p>)}
    </div>
    <div class="reveal rounded-3xl border border-slate-200 bg-white p-8 shadow-xl shadow-brand/10" style="--d:200ms">
      <h3 class="text-sm font-bold uppercase tracking-[.18em] text-brand">Areas we serve</h3>
      <ul class="mt-5 flex flex-wrap gap-2.5">
        {l.areas.map((a) => <li class="rounded-full border border-slate-200 bg-mist px-4 py-2 text-[15px] font-medium text-ink">{a}</li>)}
      </ul>
    </div>
  </div>
</section>
