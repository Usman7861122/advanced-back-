---
import DriftBg from '../ui/DriftBg.astro';
import { reviews } from '../../data/reviews';
const loop = [...reviews, ...reviews];
---
<section id="reviews" class="relative overflow-hidden bg-white py-24 sm:py-32">
  <DriftBg soft />
  <div class="relative z-10 mx-auto max-w-7xl px-5">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow reveal">Google reviews</p>
        <h2 class="h-display reveal mt-4" style="--d:80ms">What patients say about us</h2>
      </div>
      <a href="/testimonials/" class="btn btn-solid reveal" style="--d:160ms">Read more reviews <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="relative z-10 mt-14 [mask-image:linear-gradient(90deg,transparent,#000_6%,#000_94%,transparent)]">
    <div class="marquee gap-6 px-3" style="--t:70s">
      {loop.map((r) => (
        <figure class="flex w-[22rem] shrink-0 flex-col justify-between rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-2 hover:border-brand/40 hover:shadow-xl hover:shadow-brand/15">
          <div>
            <div class="flex gap-0.5 text-amber-400" aria-label="5 out of 5 stars" role="img">
              {Array.from({ length: 5 }).map(() => (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3 6.5 7 .9-5.2 4.9 1.4 7L12 17.8 5.8 21.3l1.4-7L2 9.4l7-.9L12 2Z" /></svg>
              ))}
            </div>
            <blockquote class="mt-4 text-[16px] leading-relaxed text-slate-700">“{r.t}”</blockquote>
          </div>
          <figcaption class="mt-6 flex items-center gap-3 border-t border-slate-100 pt-5">
            <span class="grid h-11 w-11 place-items-center rounded-full bg-gradient-to-br from-brand to-leaf font-bold text-white">{r.n[0]}</span>
            <span><span class="block font-bold">{r.n}</span><span class="text-sm text-slate-500">Google review</span></span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
