---
import DriftBg from '../ui/DriftBg.astro';
import { img } from '../../data/images';
import { site } from '../../data/site';
---
<section class="relative overflow-hidden bg-mist py-24 sm:py-28">
  <DriftBg soft />
  <div class="relative z-10 mx-auto max-w-6xl px-5">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow reveal">Insurance</p>
      <h2 class="h-display reveal mt-4" style="--d:80ms">Accepted Insurances</h2>
      <p class="lead reveal mt-5" style="--d:160ms">We work with many major plans. Call <a href={site.phoneHref} class="font-bold text-brand underline-offset-4 hover:underline">{site.phone}</a> and our team will help you confirm your coverage.</p>
    </div>
    <div class="mt-14 grid grid-cols-2 gap-5 sm:grid-cols-4">
      {img.insurance.map((src, i) => (
        <div class="reveal group grid aspect-square place-items-center rounded-2xl border border-slate-200 bg-white p-7 transition duration-300 hover:-translate-y-2 hover:border-brand/40 hover:shadow-xl hover:shadow-brand/15" style={`--d:${(i % 4) * 90}ms`}>
          <img src={src} alt="Accepted insurance provider logo" class="max-h-full max-w-full object-contain grayscale transition duration-500 group-hover:grayscale-0" loading="lazy" />
        </div>
      ))}
    </div>
    <div class="mt-10 text-center"><a href="/insurance/" class="btn btn-solid reveal">See insurance details <span class="arrow" aria-hidden="true">→</span></a></div>
  </div>
</section>
