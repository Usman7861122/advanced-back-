---
import DriftBg from '../ui/DriftBg.astro';
import { img } from '../../data/images';
const posts = [
  { t: 'Advanced Back & Neck Pain Center Named Delaware’s Best Chiropractor in the First State Favorites Competition!', href: '/advanced-back-neck-pain-center-named-delawares-best-chiropractor-in-the-first-state-favorites-competition/', img: img.blog[0], badge: true },
  { t: 'Can Chiropractic Care Help Degenerative Disc Disease? New Research on Neck Pain and Spinal Disc Health', href: '/can-chiropractic-care-help-degenerative-disc-disease-new-research-on-neck-pain-and-spinal-disc-health/', img: img.blog[1] },
  { t: 'Is Cracking Your Own Neck Dangerous? What Research Says About Neck Pain and Chiropractic Care', href: '/is-cracking-your-own-neck-dangerous-what-research-says-about-neck-pain-and-chiropractic-care/', img: img.blog[2] },
  { t: 'Can Posture Be Connected to Childhood Bedwetting? New Research Offers an Interesting Clue', href: '/can-posture-be-connected-to-childhood-bedwetting-new-research-offers-an-interesting-clue/', img: img.blog[3] },
];
---
<section id="blog" class="relative overflow-hidden bg-mist py-24 sm:py-32">
  <DriftBg soft />
  <div class="relative z-10 mx-auto max-w-7xl px-5">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow reveal">Blog articles</p>
        <h2 class="h-display reveal mt-4" style="--d:80ms">News and research for a healthier spine</h2>
      </div>
      <a href="/blog/" class="btn btn-ghost reveal text-abyss hover:!bg-abyss hover:!text-white" style="--d:160ms">All articles <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    <div class="mt-14 grid gap-7 sm:grid-cols-2 lg:grid-cols-4">
      {posts.map((p, i) => (
        <a href={p.href} class="reveal group block" style={`--d:${i * 90}ms`}>
          <div class="overflow-hidden rounded-[1.25rem] bg-white">
            <img src={p.img} alt={p.t} class:list={['sq !rounded-[1.25rem] transition duration-700 group-hover:scale-105', p.badge && '!object-contain p-10']} loading="lazy" />
          </div>
          <h3 class="mt-5 text-lg font-bold leading-snug transition group-hover:text-brand">{p.t}</h3>
          <span class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-brand">Read article <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </div>
</section>
