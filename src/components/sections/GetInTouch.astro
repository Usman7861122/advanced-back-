---
import DriftBg from '../ui/DriftBg.astro';
import ContactForm from '../islands/ContactForm';
import { site } from '../../data/site';

const mapSrc = 'https://www.google.com/maps?q=' + encodeURIComponent(site.address) + '&output=embed';
const cards = [
  { k: 'Call', v: site.phone, href: site.phoneHref, d: 'Talk to our front desk',
    icon: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z' },
  { k: 'Visit', v: site.street + ' ' + site.cityLine, href: site.mapHref, d: 'Omega Professional Center', ext: true,
    icon: 'M12 22s7-6.3 7-12a7 7 0 1 0-14 0c0 5.7 7 12 7 12Zm0-9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z' },
  { k: 'Fax', v: site.fax, href: 'tel:' + site.fax, d: 'For records and referrals',
    icon: 'M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z' },
];
---
<section id="contact" class="relative isolate overflow-hidden bg-mist py-24 sm:py-28">
  <DriftBg soft class="-z-10" />
  <div class="mx-auto max-w-7xl px-5">
    <div class="max-w-3xl">
      <p class="eyebrow reveal">Get in touch</p>
      <h2 class="h-display reveal mt-4 text-ink" style="--d:100ms">Questions? <span class="italic text-brand">We are here.</span></h2>
      <p class="reveal mt-5 text-lg text-slate-600" style="--d:200ms">Call, send a message or stop by our Newark office. We usually reply within one business day.</p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-[1.05fr_1fr]">
      <!-- left: contact cards + hours -->
      <div class="grid content-start gap-6">
        <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
          {cards.map((c, i) => (
            <a href={c.href} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noreferrer' : undefined}
               class="reveal group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand/40 hover:shadow-xl hover:shadow-brand/10"
               style={`--d:${i * 100}ms`}>
              <span class="grid h-11 w-11 place-items-center rounded-xl bg-mist text-brand transition group-hover:bg-brand group-hover:text-white">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={c.icon} /></svg>
              </span>
              <p class="eyebrow mt-4 !text-[.68rem]">{c.k}</p>
              <p class="mt-1 text-[15px] font-semibold leading-snug text-ink">{c.v}</p>
              <p class="mt-1 text-[13px] text-slate-500">{c.d}</p>
            </a>
          ))}
        </div>

        <div class="reveal rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" style="--d:200ms">
          <div class="flex items-center justify-between gap-3">
            <h3 class="font-display text-2xl font-semibold text-ink">Office hours</h3>
            <span id="open-pill" class="hidden items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700"><i class="h-1.5 w-1.5 rounded-full bg-emerald-500"></i> Open today</span>
          </div>
          <ul class="mt-4 divide-y divide-slate-100 text-[14.5px]" id="hours">
            {site.hours.map((h) => (
              <li data-day={h.day} class="flex items-start justify-between gap-4 rounded-lg px-3 py-2.5 transition-colors">
                <span class="font-semibold text-ink">{h.day}</span>
                <span class:list={['text-right', h.time === 'Closed' ? 'text-slate-400' : 'text-slate-600']}>{h.time}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- right: form + map -->
      <div class="grid content-start gap-6">
        <div class="reveal rounded-3xl border border-slate-200 bg-white p-6 shadow-xl shadow-brand/5 sm:p-8" style="--d:120ms">
          <h3 class="font-display text-2xl font-semibold text-ink">Send us a message</h3>
          <p class="mb-6 mt-1 text-sm text-slate-500">For appointments, please use the Request Appointment button.</p>
          <ContactForm client:visible />
        </div>
        <div class="reveal overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm" style="--d:200ms">
          <iframe title="Map to Advanced Back & Neck Pain Center" src={mapSrc} class="block h-64 w-full border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var d = new Date().toLocaleDateString('en-US', { weekday: 'long', timeZone: 'America/New_York' });
    var li = document.querySelector('#hours [data-day="' + d + '"]');
    if (!li) return;
    li.classList.add('bg-mist');
    li.querySelector('span').insertAdjacentHTML('beforeend', ' <em class="ml-1 text-[11px] font-semibold not-italic text-brand">Today</em>');
    if (!/Closed/.test(li.textContent)) { var p = document.getElementById('open-pill'); if (p) { p.classList.remove('hidden'); p.classList.add('inline-flex'); } }
  })();
</script>
