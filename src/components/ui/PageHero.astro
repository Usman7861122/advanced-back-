---
import DriftBg from './DriftBg.astro';
import { localCity } from '../../data/local';
interface Props { title: string; eyebrow?: string; lede?: string; image: string; imageAlt?: string; position?: string; crumbs?: { label: string; href?: string }[]; }
const { title, eyebrow, lede, image, imageAlt = '', position = 'center', crumbs = [] } = Astro.props;
const parts = title.split(localCity);
---
<section class="relative isolate overflow-hidden bg-abyss text-white">
  <img src={image} alt={imageAlt} class="absolute inset-0 -z-20 h-full w-full object-cover" style={`object-position:${position}`} fetchpriority="high" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-abyss/92 via-abyss/78 to-abyss/45"></div>
  <DriftBg soft class="-z-10 mix-blend-screen" />
  <div class="mx-auto max-w-7xl px-5 pb-20 pt-16 sm:pb-24 sm:pt-20">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-6 text-sm text-white/70">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-white">Home</a></li>
          {crumbs.map((c) => (<li class="flex items-center gap-2"><span aria-hidden="true">/</span>{c.href ? <a href={c.href} class="hover:text-white">{c.label}</a> : <span aria-current="page" class="text-white">{c.label}</span>}</li>))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow reveal !text-leaf">{eyebrow}</p>}
    <h1 class="reveal mt-4 max-w-4xl font-display text-[clamp(2.6rem,6vw,5rem)] font-semibold leading-[1] tracking-tight" style="--d:80ms">{parts.length > 1 ? parts.map((t, i) => (<>{t}{i < parts.length - 1 && <span class="italic text-sky">{localCity}</span>}</>)) : title}</h1>
    {lede && <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-white/85" style="--d:180ms">{lede}</p>}
    <div class="reveal mt-9 flex flex-wrap gap-4" style="--d:280ms"><slot /></div>
  </div>
</section>
