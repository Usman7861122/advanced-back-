---
import { site } from '../../data/site';
interface Props { title?: string; class?: string }
const { title = 'Office hours', class: cls = '' } = Astro.props;
const rows = site.hours.map((h) => {
  const note = h.time.match(/\(([^)]+)\)/)?.[1] ?? '';
  const main = h.time.replace(/\s*\([^)]*\)/, '');
  return { day: h.day, closed: h.time === 'Closed', slots: main.split(/,\s*/), note };
});
---
<div class:list={['office-hours rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1.5 hover:border-brand/40 hover:shadow-xl hover:shadow-brand/15', cls]}>
  <div class="flex items-center justify-between gap-3">
    <h3 class="font-display text-2xl font-semibold text-ink">{title}</h3>
    <span data-open-pill class="hidden items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700"><i class="h-1.5 w-1.5 rounded-full bg-emerald-500"></i> Open today</span>
  </div>
  <ul class="mt-4 text-[14.5px]">
    {rows.map((r) => (
      <li data-day={r.day} class="grid grid-cols-[minmax(5.5rem,auto)_1fr] items-start gap-x-4 border-t border-slate-100 px-3 py-3 first:border-t-0 transition duration-200 hover:bg-mist hover:pl-4 data-[today=true]:rounded-xl data-[today=true]:border-transparent data-[today=true]:bg-mist">
        <span class="flex flex-wrap items-center gap-x-2 gap-y-1 font-semibold text-ink">
          {r.day}
          <em data-today-tag hidden class="rounded-full bg-brand px-2 py-0.5 text-[10.5px] font-semibold not-italic uppercase tracking-wide text-white">Today</em>
        </span>
        <span class:list={['text-right leading-snug', r.closed ? 'text-slate-500' : 'text-slate-600']}>
          {r.slots.map((s) => <span class="block whitespace-nowrap">{s}</span>)}
          {r.note && <span class="mt-0.5 block text-[12.5px] text-slate-500">{r.note}</span>}
        </span>
      </li>
    ))}
  </ul>
</div>

<script is:inline>
  (function () {
    var d = new Date().toLocaleDateString('en-US', { weekday: 'long', timeZone: 'America/New_York' });
    document.querySelectorAll('.office-hours').forEach(function (box) {
      var li = box.querySelector('li[data-day="' + d + '"]');
      if (!li) return;
      li.setAttribute('data-today', 'true');
      var tag = li.querySelector('[data-today-tag]'); if (tag) tag.hidden = false;
      var pill = box.querySelector('[data-open-pill]');
      if (pill && !/Closed/.test(li.textContent)) { pill.classList.remove('hidden'); pill.classList.add('inline-flex'); }
    });
  })();
</script>
