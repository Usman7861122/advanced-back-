---
import { consent } from '../../data/consent';
const cats = consent.categories.filter((c) => c.active);
const config = JSON.stringify({ version: consent.version, days: consent.days, ids: cats.map((c) => c.id) });
---
<div id="cookie-banner" data-config={config} role="dialog" aria-label={consent.title} aria-live="polite" hidden
  class="cb fixed bottom-3 left-3 z-[90] w-[calc(100%-1.5rem)] max-w-[21.5rem] rounded-2xl border border-slate-200 bg-white/95 p-4 text-ink shadow-2xl shadow-abyss/20 backdrop-blur">
  <div class="flex items-start gap-3">
    <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-mist text-brand" aria-hidden="true">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 9 9 4 4 0 0 1-4-4 4 4 0 0 1-5-5Z"/><circle cx="8.5" cy="11" r=".8"/><circle cx="12" cy="16" r=".8"/><circle cx="15.5" cy="13" r=".8"/></svg>
    </span>
    <div class="min-w-0">
      <p class="text-[15px] font-semibold leading-tight">{consent.title}</p>
      <p class="mt-1 text-[13px] leading-snug text-slate-600">{consent.text} <a href={consent.policyHref} class="font-semibold text-brand underline-offset-2 hover:underline">Cookie policy</a></p>
    </div>
  </div>

  <div id="cb-panel" hidden class="mt-3 border-t border-slate-100 pt-3">
    <ul class="grid gap-2.5">
      {cats.map((c) => (
        <li class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="text-[13px] font-semibold leading-tight">{c.label}</p>
            <p class="text-[12px] leading-snug text-slate-500">{c.text}</p>
          </div>
          <label class="relative mt-0.5 inline-flex shrink-0 cursor-pointer items-center">
            <input type="checkbox" data-cat={c.id} checked={c.locked} disabled={c.locked} class="peer sr-only" aria-label={c.label} />
            <span class="h-5 w-9 rounded-full bg-slate-300 transition peer-checked:bg-brand peer-disabled:opacity-60 peer-focus-visible:ring-2 peer-focus-visible:ring-sky peer-focus-visible:ring-offset-2"></span>
            <span class="absolute left-0.5 top-0.5 h-4 w-4 rounded-full bg-white shadow transition peer-checked:translate-x-4"></span>
          </label>
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    <button type="button" id="cb-accept" class="rounded-full bg-brand px-4 py-2 text-[13px] font-semibold text-white transition hover:bg-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky">{consent.buttons.accept}</button>
    <button type="button" id="cb-reject" class="rounded-full border border-slate-300 px-4 py-2 text-[13px] font-semibold transition hover:border-brand hover:text-brand focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky">{consent.buttons.reject}</button>
    <button type="button" id="cb-custom" aria-expanded="false" aria-controls="cb-panel" class="px-1 py-2 text-[13px] font-semibold text-brand underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-sky">{consent.buttons.customize}</button>
    <button type="button" id="cb-save" hidden class="rounded-full bg-brand px-4 py-2 text-[13px] font-semibold text-white transition hover:bg-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky">{consent.buttons.save}</button>
  </div>
</div>

<style is:global>
  .cb { animation: cbin .35s ease-out both; }
  @keyframes cbin { from { opacity: 0; transform: translateY(12px); } }
  @media (prefers-reduced-motion: reduce) { .cb { animation: none; } }
  #cookie-banner[hidden], #cookie-banner [hidden] { display: none !important; }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById('cookie-banner');
    if (!el) return;
    var cfg = JSON.parse(el.dataset.config);
    var KEY = 'abnp-consent';
    var panel = document.getElementById('cb-panel');
    var bAccept = document.getElementById('cb-accept');
    var bReject = document.getElementById('cb-reject');
    var bCustom = document.getElementById('cb-custom');
    var bSave = document.getElementById('cb-save');
    var boxes = el.querySelectorAll('input[data-cat]');
    var chatLoaded = false;

    function read() {
      try {
        var v = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (v && v.v === cfg.version && Date.now() - v.t < cfg.days * 864e5) return v;
      } catch (e) {}
      return null;
    }
    function loadChat() {
      if (chatLoaded) return; chatLoaded = true;
      var s = document.createElement('script');
      s.src = 'https://widgets.leadconnectorhq.com/loader.js';
      s.setAttribute('data-resources-url', 'https://widgets.leadconnectorhq.com/chat-widget/loader.js');
      s.setAttribute('data-widget-id', '6af33435b488c87e6896980c');
      document.body.appendChild(s);
    }
    function runGated(c) {
      document.querySelectorAll('script[type="text/plain"][data-consent]').forEach(function (old) {
        if (old.dataset.done || !c[old.dataset.consent]) return;
        var s = document.createElement('script');
        for (var i = 0; i < old.attributes.length; i++) {
          var a = old.attributes[i]; if (a.name !== 'type') s.setAttribute(a.name, a.value);
        }
        s.text = old.text; old.dataset.done = '1'; old.parentNode.insertBefore(s, old.nextSibling);
      });
    }
    function apply(c) { if (c.functional) loadChat(); runGated(c); }
    function save(c) {
      c.necessary = true;
      try { localStorage.setItem(KEY, JSON.stringify({ v: cfg.version, t: Date.now(), c: c })); } catch (e) {}
      apply(c); hide();
      document.dispatchEvent(new CustomEvent('abnp:consent', { detail: c }));
    }
    function all(val) { var c = {}; cfg.ids.forEach(function (id) { c[id] = id === 'necessary' ? true : val; }); return c; }
    function setBoxes(c) { boxes.forEach(function (b) { if (!b.disabled) b.checked = !!(c && c[b.dataset.cat]); }); }
    function openPanel(open) {
      panel.hidden = !open; bSave.hidden = !open; bAccept.hidden = open; bReject.hidden = open;
      bCustom.setAttribute('aria-expanded', String(open));
      bCustom.textContent = open ? 'Back' : 'Customize';
    }
    function show(withPanel) {
      el.hidden = false; openPanel(!!withPanel);
      if (withPanel) { var f = el.querySelector('input:not([disabled])'); if (f) f.focus(); }
    }
    function hide() { el.hidden = true; }

    bAccept.addEventListener('click', function () { save(all(true)); });
    bReject.addEventListener('click', function () { save(all(false)); });
    bCustom.addEventListener('click', function () { openPanel(panel.hidden); });
    bSave.addEventListener('click', function () {
      var c = all(false); boxes.forEach(function (b) { c[b.dataset.cat] = b.checked; }); save(c);
    });
    el.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !panel.hidden) openPanel(false); });

    // "Cookie settings" links anywhere on the site
    document.addEventListener('click', function (e) {
      var t = e.target.closest && e.target.closest('[data-cookie-settings]');
      if (!t) return; e.preventDefault();
      var r = read(); setBoxes(r ? r.c : null); show(true);
    });
    window.abnpConsent = { open: function () { var r = read(); setBoxes(r ? r.c : null); show(true); }, get: function () { var r = read(); return r ? r.c : null; } };

    var saved = read();
    if (saved) { setBoxes(saved.c); apply(saved.c); }
    else { setBoxes(null); show(false); }
  })();
</script>
