---
import PageLayout from '../layouts/PageLayout.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { posts, getPost } from '../data/posts';
import { site } from '../data/site';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { post: p.slug } }));
}
const post = getPost(Astro.params.post as string)!;
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const S = '/services/';
const L = {
  sciatica: { label: 'Sciatica relief in Newark, DE', href: S + 'chiropractor-for-sciatica-in-newark-de/' },
  decompression: { label: 'Spinal decompression therapy in Newark, DE', href: S + 'spinal-decompression-therapy-in-newark-de/' },
  herniated: { label: 'Herniated disc care in Newark, DE', href: S + 'herniated-disc-chiropractor-in-newark-de/' },
  back: { label: 'Back pain treatment in Newark, DE', href: S + 'back-pain-chiropractor-in-newark-de/' },
  neck: { label: 'Neck pain relief in Newark, DE', href: S + 'chiropractor-for-neck-pain/' },
  car: { label: 'Car accident chiropractor in Newark, DE', href: S + 'car-accident-chiropractor/' },
  headache: { label: 'Headache and migraine care in Newark, DE', href: S + 'chiropractor-for-headaches-migraines-in-newark-de/' },
  shockwave: { label: 'Shockwave therapy in Newark, DE', href: S + 'shockwave-therapy-in-newark-de/' },
  arthritis: { label: 'Arthritis pain care in Newark, DE', href: S + 'arthritis-pain-chiropractor-in-newark-de/' },
};
const relatedBySlug: Record<string, (keyof typeof L)[]> = {
  'sharp-lower-back-pain-radiating-down-your-leg-in-newark-de-heres-what-it-means-and-how-to-fix-it': ['sciatica', 'decompression', 'herniated'],
  'non-surgical-herniated-disc-treatment-in-newark-de-real-pain-relief-without-surgery': ['decompression', 'sciatica', 'herniated'],
  'the-role-of-chiropractic-care-in-treating-lumbar-disc-herniations': ['decompression', 'herniated', 'sciatica'],
  'can-chiropractic-care-help-degenerative-disc-disease-new-research-on-neck-pain-and-spinal-disc-health': ['decompression', 'neck', 'herniated'],
  'the-psoas-muscle-low-back-pain-a-common-but-often-overlooked-connection': ['back', 'sciatica', 'decompression'],
  'posture-correction-for-desk-workers-in-newark-de-erase-neck-shoulder-and-back-pain': ['neck', 'back', 'decompression'],
  'top-10-signs-you-have-whiplash': ['car', 'neck', 'headache'],
  'is-cracking-your-own-neck-dangerous-what-research-says-about-neck-pain-and-chiropractic-care': ['neck', 'headache'],
  'the-benefits-of-shockwave-therapy-for-musculoskeletal-pain-in-newark-de': ['shockwave', 'back', 'sciatica'],
  'understanding-headaches-types-causes-and-how-chiropractic-care-can-help': ['headache', 'neck'],
  'newark-chiropractor-can-help-with-migraines-headaches': ['headache', 'neck'],
  'newark-chiropractic-care-can-help-arthritis-pain': ['arthritis', 'back'],
  'what-is-a-neck-hump-and-how-to-get-rid-of-it': ['neck', 'back'],
  'newark-chiropractor-talks-chiropractic-and-a-sedentary-lifestyle': ['back', 'neck', 'decompression'],
};
const related = (relatedBySlug[post.slug] ?? ['back', 'neck']).map((k) => L[k]);
const more = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
const origin = (Astro.site ?? new URL('https://advancedback.com')).origin;
const url = `${origin}/${post.slug}/`;
const imageUrl = origin + post.image;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  headline: post.title.slice(0, 110),
  description: post.excerpt,
  image: [imageUrl],
  datePublished: post.date,
  dateModified: post.date,
  author: { '@type': 'Organization', name: 'Advanced Back & Neck Pain Center', url: origin + '/' },
  publisher: { '@type': 'Organization', name: 'Advanced Back & Neck Pain Center', logo: { '@type': 'ImageObject', url: origin + '/images/logo-clear.png' } },
};
const short = post.title.length > 48 ? post.title.slice(0, 48).replace(/\s+\S*$/, '') + '…' : post.title;
---
<PageLayout
  title={post.title.length > 52 ? post.title : `${post.title} | Advanced Back & Neck Pain Center`}
  type="article"
  published={post.date}
  heading={post.title}
  eyebrow={fmt(post.date)}
  lede={`${post.minutes} min read`}
  description={post.excerpt}
  image={post.image}
  imageAlt={post.imageAlt}
  position="center"
  crumbs={[{ label: 'Blog', href: '/blog/' }, { label: short }]}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <article class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-5">
      <div class:list={['mb-10 overflow-hidden rounded-2xl', post.contain ? 'bg-mist p-6' : '']}>
        <img src={post.image} alt={post.imageAlt} class:list={['mx-auto w-full', post.contain ? 'max-h-[28rem] object-contain' : 'rounded-2xl']} />
      </div>
      <div class="post-body" set:html={post.html} />
      <aside class="mt-12 rounded-2xl border border-slate-200 bg-white p-6">
        <h2 class="font-display text-2xl font-semibold text-ink">Related care at our Newark office</h2>
        <ul class="mt-4 grid gap-2">
          {related.map((r) => <li><a href={r.href} class="font-semibold text-brand underline-offset-4 hover:underline">{r.label} →</a></li>)}
        </ul>
      </aside>
      <div class="mt-6 flex flex-wrap gap-3 rounded-2xl border border-slate-200 bg-mist p-6">
        <a href={site.appointment} class="btn btn-solid">Book an appointment</a>
        <a href={site.phoneHref} class="btn btn-ghost">Call {site.phone}</a>
      </div>
    </div>
  </article>

  <section class="bg-mist py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-5">
      <h2 class="h-display">More articles</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {more.map((p) => (
          <a href={`/${p.slug}/`} class="group rounded-2xl border border-slate-200 bg-white p-6 transition duration-300 hover:-translate-y-1.5 hover:border-brand/40 hover:shadow-xl hover:shadow-brand/15">
            <p class="text-sm font-semibold text-brand">{fmt(p.date)}</p>
            <h3 class="mt-2 font-display text-lg font-semibold leading-snug text-ink">{p.title}</h3>
            <span class="mt-4 inline-block font-bold text-brand">Read article →</span>
          </a>
        ))}
      </div>
      <p class="mt-8"><a href="/blog/" class="btn btn-ghost">All articles</a></p>
    </div>
  </section>
  <FinalCta />
</PageLayout>

<style is:global>
  .post-body { font-size: 1.125rem; line-height: 1.8; color: #334155; }
  .post-body p { margin-top: 1.1rem; }
  .post-body h2 { margin-top: 2.5rem; font-family: var(--font-display, inherit); font-size: 1.85rem; font-weight: 600; line-height: 1.2; color: #0b1f2a; }
  .post-body h3 { margin-top: 1.8rem; font-size: 1.3rem; font-weight: 700; color: #0b1f2a; }
  .post-body ul, .post-body ol { margin-top: 1rem; padding-left: 1.4rem; list-style: disc; }
  .post-body ol { list-style: decimal; }
  .post-body li { margin-top: .45rem; padding-left: .25rem; }
  .post-body a { color: #0f6280; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .post-body hr { margin: 2rem 0; border-color: #e2e8f0; }
</style>
