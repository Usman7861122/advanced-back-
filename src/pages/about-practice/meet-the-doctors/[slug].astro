---
import PageLayout from '../../../layouts/PageLayout.astro';
import LocalSection from '../../../components/pages/LocalSection.astro';
import Reviews from '../../../components/sections/Reviews.astro';
import FinalCta from '../../../components/sections/FinalCta.astro';
import { doctors } from '../../../data/doctors';
import { img } from '../../../data/images';
import { site } from '../../../data/site';

export function getStaticPaths() {
  return doctors.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}
const { d } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Physician',
  name: d.name,
  medicalSpecialty: 'Chiropractic',
  jobTitle: d.role,
  url,
  image: new URL(d.portrait, Astro.site).href,
  worksFor: { '@type': 'MedicalBusiness', name: site.name, telephone: site.phone, address: { '@type': 'PostalAddress', streetAddress: '54 Omega Drive, Suite F', addressLocality: 'Newark', addressRegion: 'DE', postalCode: '19713', addressCountry: 'US' } },
};
---
<PageLayout
  title={`${d.name}, DC | ${site.name}`}
  heading={d.name}
  eyebrow={`${d.role} · Newark, DE`}
  lede={d.lede}
  description={d.description}
  image={img.doctorHero}
  imageAlt="A chiropractor explaining a spine model to a patient"
  crumbs={[{ label: 'About Practice', href: '/about-practice/' }, { label: 'Meet the Doctors', href: '/about-practice/meet-the-doctors/' }, { label: d.name }]}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />
  <Fragment slot="actions">
    <a href={site.appointment} class="btn-appt on-dark"><span>Request Appointment</span><span class="arrow" aria-hidden="true">→</span></a>
    <a href={site.phoneHref} class="btn btn-ghost text-white">Call {site.phone}</a>
  </Fragment>

  <!-- Story -->
  <section class="relative overflow-hidden bg-white py-24 sm:py-32">
    <div class="mx-auto grid max-w-7xl gap-14 px-5 lg:grid-cols-[minmax(0,26rem)_1fr] lg:gap-20">
      <aside class="reveal lg:sticky lg:top-28 lg:self-start">
        <div class="relative">
          <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-sky/30 to-leaf/30 blur-2xl"></div>
          <img src={d.portrait} alt={d.portraitAlt} class="sq shadow-2xl shadow-abyss/20 !object-top" loading="eager" />
        </div>
        <dl class="mt-8 space-y-5 rounded-3xl border border-slate-200 bg-mist/60 p-6">
          {d.facts.map((f) => (
            <div>
              <dt class="text-xs font-bold uppercase tracking-[.18em] text-brand">{f.label}</dt>
              <dd class="mt-1 text-[15px] leading-relaxed text-slate-700">{f.text}</dd>
            </div>
          ))}
        </dl>
      </aside>
      <div>
        <p class="eyebrow reveal">{d.storyEyebrow}</p>
        <h2 class="h-display reveal mt-4" style="--d:80ms">{d.storyTitle}</h2>
        <div class="mt-8 space-y-5">
          {d.story.map((p, i) => <p class="lead reveal" style={`--d:${120 + i * 70}ms`}>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- Approach -->
  {d.approach && d.approach.length > 0 && (
    <section class="relative isolate overflow-hidden bg-abyss px-5 py-24 text-white sm:py-28" style="background-image:radial-gradient(60% 60% at 85% 0%, rgba(36,142,176,.4), transparent 60%)">
      <div class="mx-auto max-w-7xl">
        <p class="eyebrow reveal !text-leaf">{d.approachEyebrow}</p>
        <h2 class="h-display reveal mt-4 max-w-3xl" style="--d:80ms">{d.approachTitle}</h2>
        <ul class:list={['mt-14 grid gap-5 sm:grid-cols-2', d.approach.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
          {d.approach.map((a, i) => (
            <li class="reveal rounded-3xl border border-white/10 bg-white/[.06] p-8 backdrop-blur transition duration-300 hover:-translate-y-1.5 hover:border-sky/50" style={`--d:${160 + i * 110}ms`}>
              <h3 class="font-display text-3xl font-semibold leading-tight text-sky">{a.t}</h3>
              <p class="mt-3 leading-relaxed text-white/75">{a.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Background + published work -->
  {((d.background && d.background.length > 0) || (d.publications && d.publications.length > 0)) && (
    <section class="bg-mist py-24 sm:py-28">
      <div class:list={['mx-auto grid max-w-7xl gap-14 px-5', d.publications && d.publications.length > 0 && 'lg:grid-cols-2']}>
        <div class="max-w-3xl">
          <p class="eyebrow reveal">{d.backgroundEyebrow ?? `About ${d.name}`}</p>
          <h2 class="h-display reveal mt-4" style="--d:80ms">{d.backgroundTitle}</h2>
          <div class="mt-8 space-y-5">
            {(d.background ?? []).map((p, i) => <p class="lead reveal" style={`--d:${120 + i * 70}ms`}>{p}</p>)}
            {d.interests && <p class="reveal text-slate-600" style="--d:260ms">{d.interests}</p>}
          </div>
        </div>
        {d.publications && d.publications.length > 0 && (
          <div class="reveal self-start rounded-3xl bg-white p-8 shadow-xl shadow-brand/10" style="--d:200ms">
            <h3 class="text-sm font-bold uppercase tracking-[.18em] text-brand">Published work</h3>
            <ul class="mt-6 divide-y divide-slate-200">
              {d.publications.map((p) => (
                <li class="py-5 first:pt-0 last:pb-0">
                  <a href={p.url} target="_blank" rel="noopener" class="group block">
                    <span class="font-semibold leading-snug text-ink transition group-hover:text-brand">{p.title}</span>
                    <span class="mt-1 block text-sm text-slate-500">{p.source} <span aria-hidden="true">↗</span></span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <LocalSection topic="Chiropractor" />
  <Reviews />
  <FinalCta />
</PageLayout>
