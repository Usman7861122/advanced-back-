---
import PageLayout from '../layouts/PageLayout.astro';
import { img } from '../data/images';
import { site } from '../data/site';

// Same booking calendar as the live site (LeadConnector).
const bookingId = 'LyI7Z0oCrzZATAabrfMs';
const bookingSrc = `https://api.ironhealthsolutions.com/widget/booking/${bookingId}`;
---
<PageLayout
  title="Request an Appointment | Advanced Back & Neck Pain Center"
  heading="Request an appointment"
  eyebrow="Book online"
  lede="Pick a day and time that works for you. Our team will confirm your visit."
  description="Take the first step toward a pain-free life today. Easily book your initial chiropractic evaluation or spinal decompression consultation online."
  image={img.doctorHero}
  imageAlt="A chiropractor welcoming a new patient"
  position="center 35%"
  crumbs={[{ label: 'Appointment' }]}
>
  <section class="bg-mist py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 lg:grid-cols-[1fr_20rem]">
      <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white p-2 shadow-sm sm:p-4">
        <iframe
          src={bookingSrc}
          id={`${bookingId}_booking`}
          title="Book a new patient appointment"
          style="width:100%;min-height:800px;border:none;overflow:hidden"
          scrolling="no"
          loading="lazy"
        ></iframe>
        <noscript><p class="p-6">Online booking needs JavaScript. Please call <a class="font-semibold text-brand" href={site.phoneHref}>{site.phone}</a> to book.</p></noscript>
      </div>

      <aside class="grid content-start gap-5">
        <div class="reveal rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="font-display text-2xl font-semibold text-ink">Prefer to call?</h2>
          <p class="mt-2 text-slate-600">We can often get you in the same day.</p>
          <a href={site.phoneHref} class="btn btn-solid mt-5 w-full justify-center">{site.phone}</a>
        </div>
        <div class="reveal rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="font-display text-2xl font-semibold text-ink">Office hours</h2>
          <ul class="mt-4 divide-y divide-slate-100 text-[14.5px]">
            {site.hours.map((h) => <li class="flex flex-wrap justify-between gap-x-4 py-2.5"><span class="font-semibold text-ink">{h.day}</span><span class="text-slate-600">{h.time}</span></li>)}
          </ul>
        </div>
        <div class="reveal rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="font-display text-2xl font-semibold text-ink">Before you come</h2>
          <ul class="mt-4 grid gap-3 text-slate-700">
            <li class="flex gap-3"><span class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-leaf"></span>A photo ID and your insurance card</li>
            <li class="flex gap-3"><span class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-leaf"></span>Your medication list</li>
          </ul>
          <a href="/resources/first-visit/" class="mt-5 inline-flex items-center gap-2 font-semibold text-brand">What to expect <span aria-hidden="true">→</span></a>
          <br />
          <a href="/resources/new-patient-paperwork/" class="mt-2 inline-flex items-center gap-2 font-semibold text-brand">Fill out forms first <span aria-hidden="true">→</span></a>
        </div>
      </aside>
    </div>
  </section>
  <script is:inline src="https://api.ironhealthsolutions.com/js/form_embed.js"></script>
</PageLayout>
