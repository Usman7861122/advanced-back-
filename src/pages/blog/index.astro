---
import PageLayout from '../../layouts/PageLayout.astro';
import { posts } from '../../data/posts';
import { img } from '../../data/images';
const fmt = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---
<PageLayout
  title="Chiropractic & Spinal Wellness Blog | Advanced Back & Neck Pain Center"
  heading="Blog"
  eyebrow="Articles"
  lede="Plain-English advice on back pain, neck pain, posture and recovery from our Newark chiropractors."
  description="Read chiropractic and spinal wellness articles from Advanced Back & Neck Pain Center in Newark, DE: back pain, neck pain, posture, headaches and more."
  image={img.aboutHero}
  imageAlt="The team at Advanced Back & Neck Pain Center"
  position="center 35%"
  crumbs={[{ label: 'Blog' }]}
>
  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-5">
      <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p, i) => (
          <a href={`/${p.slug}/`} class="reveal group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-300 hover:-translate-y-1.5 hover:border-brand/40 hover:shadow-xl hover:shadow-brand/15" style={`--d:${(i % 3) * 80}ms`}>
            <div class:list={['aspect-[16/10] overflow-hidden', p.contain ? 'bg-mist p-4' : 'bg-slate-100']}>
              <img src={p.image} alt={p.imageAlt} loading={i < 3 ? 'eager' : 'lazy'} class:list={['h-full w-full transition duration-700 group-hover:scale-105', p.contain ? 'object-contain' : 'object-cover']} />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="text-sm font-semibold text-brand">{fmt(p.date)} · {p.minutes} min read</p>
              <h2 class="mt-2 font-display text-xl font-semibold leading-snug text-ink">{p.title}</h2>
              <p class="mt-3 flex-1 text-slate-600">{p.excerpt}</p>
              <span class="mt-5 font-bold text-brand">Read article <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
