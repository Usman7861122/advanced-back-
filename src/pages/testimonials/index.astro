---
import PageLayout from '../../layouts/PageLayout.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { reviews } from '../../data/reviews';
import { img } from '../../data/images';
import { site } from '../../data/site';
---
<PageLayout
  title="Patient Reviews & Success Stories | Advanced Back & Neck Pain Center"
  heading="Patient reviews and success stories"
  eyebrow="Testimonials"
  lede="Real words from people we have helped in Newark and nearby towns."
  description="Read real Google reviews and success stories from patients of Advanced Back & Neck Pain Center in Newark, DE, who found lasting relief from back and neck pain."
  image={img.aboutHero}
  imageAlt="Smiling patients and staff at Advanced Back & Neck Pain Center"
  position="center 35%"
  crumbs={[{ label: 'Testimonials' }]}
>
  <Fragment slot="actions">
    <a href="/testimonials/video-testimonials/" class="btn btn-appt on-dark">Watch video stories</a>
    <a href={site.phoneHref} class="btn btn-ghost text-white">Call {site.phone}</a>
  </Fragment>

  <section class="bg-mist py-24 sm:py-28">
    <div class="mx-auto max-w-7xl px-5">
      <p class="eyebrow reveal">Google reviews</p>
      <h2 class="h-display reveal mt-4" style="--d:80ms">What patients say about us</h2>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {reviews.map((r, i) => (
          <figure class="reveal flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-2 hover:border-brand/40 hover:shadow-xl hover:shadow-brand/15" style={`--d:${(i % 3) * 70}ms`}>
            <div>
              <div class="flex gap-0.5 text-leaf" aria-label="5 out of 5 stars">{[0, 1, 2, 3, 4].map(() => <span aria-hidden="true">★</span>)}</div>
              <blockquote class="mt-4 leading-relaxed text-slate-700">“{r.t}”</blockquote>
            </div>
            <figcaption class="mt-6 font-semibold text-ink">{r.n}</figcaption>
          </figure>
        ))}
      </div>
      <div class="reveal mt-12 flex flex-wrap gap-3">
        <a href="/testimonials/video-testimonials/" class="btn btn-solid">Watch video testimonials <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  <FinalCta />
</PageLayout>
